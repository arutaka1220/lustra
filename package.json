{
  "name": "lustra",
  "private": true,
  "version": "1.0.0-beta.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:file": "LUSTRA_E2E_FILE_MODE=1 bun run build && LUSTRA_E2E_FILE_MODE=1 playwright test",
    "media": "bun scripts/media/cli.ts all",
    "media:screenshots": "bun scripts/media/cli.ts screenshots --language both",
    "media:screenshots:ja": "bun scripts/media/cli.ts screenshots --language ja",
    "media:screenshots:en": "bun scripts/media/cli.ts screenshots --language en",
    "media:examples": "bun scripts/media/cli.ts examples",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "bun run test && bun run test:e2e && bun run test:rust",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons:generate": "bun run tauri icon src-tauri/app-icon.svg --output src-tauri/icons"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/noto-sans-jp": "^5.2.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "exifr": "^7.1.3",
    "i18next": "^25.5.2",
    "lucide-react": "^0.468.0",
    "pixi.js": "^8.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.7.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@fontsource-variable/m-plus-1": "^5.3.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "gen-interface-jp": "0.8.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.1.1"
  }
}
